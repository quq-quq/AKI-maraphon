  subtitles:
  - text: "\u041A\u043E\u043D\u0446\u043E\u0432\u043A\u0430 2: \u0432\u043E\u0437\u0434\u0443\u0445
      \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u0432 \u0431\u043E\u044E
      \u0441 \u041D\u0430\u0433\u043E\u0439."
    seconds: 4
    voice: {fileID: 0}
  - text: "\u042F \u043D\u0430\u043B\u043E\u0432\u0438\u043B \u0440\u044B\u0431\u044B
      \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043D\u0443\u0436\u043D\u043E \u043C\u043D\u0435 \u0438 \u043D\u0435 \u0431\u043E\u043B\u0435\u0435.
      \u042F \u043D\u0435 \u0441\u0442\u0430\u043B \u0436\u0430\u0434\u043D\u0438\u0447\u0430\u0442\u044C,
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0434\u043E\u043C\u043E\u0439
      \u0438 \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u043B \u0441\u0435\u043C\u044C\u044E."
